{
  "rubric_schema_version": "1.0.0",
  "workflow_version": "3.1.0",
  "dimensions": {
    "intent_fidelity": {"owner": "human_or_calibrated_evaluator", "scale": [0, 1], "independent": true},
    "evidence_coverage": {"owner": "code_and_independent_verifier", "scale": [0, 1], "independent": true},
    "citation_accuracy": {"owner": "code_and_independent_verifier", "scale": [0, 1], "independent": true},
    "meaning_preservation": {"owner": "human_or_calibrated_evaluator", "scale": [0, 1], "independent": true},
    "voice_fit": {"owner": "author", "scale": [0, 1], "independent": true},
    "naturalness": {"owner": "author_or_calibrated_evaluator", "scale": [0, 1], "independent": true},
    "structural_diversity": {"owner": "code_and_editor", "scale": [0, 1], "batch_metric": true},
    "package_correctness": {"owner": "code", "scale": [0, 1], "hard_gate": true},
    "live_publication_correctness": {"owner": "code", "scale": [0, 1], "hard_gate": true},
    "human_intervention_count": {"owner": "code", "unit": "count"},
    "repair_count": {"owner": "code", "unit": "count"},
    "cost": {"owner": "controller", "unit": "provider_reported"},
    "visual_usefulness": {"owner": "editor", "scale": [0, 1], "criteria": ["relationship fidelity", "useful alternative considered", "complete labels", "legibility at article and mobile widths", "no unsupported renderer text"], "limit": "A source-only inspection must not be reported as a rendered-image inspection."},
    "latency": {"owner": "controller", "unit": "milliseconds"}
  },
  "comparison_controls": {
    "pairwise_both_orders": true,
    "passage_specific_reasons": true,
    "verbosity_bias_probe": true,
    "matched_brief_and_voice_profile": true,
    "separate_clean_and_fallback_runs": true,
    "voice_choice_is_not_model_preference": true,
    "held_out_samples_required_for_promotion": true,
    "human_calibration_required_for_promotion": true
  }
}
