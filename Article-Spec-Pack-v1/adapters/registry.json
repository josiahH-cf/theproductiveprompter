{
  "adapter_registry_schema_version": "1.0.0",
  "controller_min_version": "2.0.7",
  "canonical_entrypoint": {
    "repository_path": "Article-Spec-Pack-v1/0-START-ARTICLE.md",
    "remote_url": "https://raw.githubusercontent.com/josiahH-cf/theproductiveprompter/main/Article-Spec-Pack-v1/0-START-ARTICLE.md",
    "update_policy": "Adapters dereference this entrypoint at invocation and never copy its command sequence."
  },
  "adapters": [
    {
      "adapter_id": "shared-agent-skill",
      "source": "adapters/start-article",
      "install_targets": [
        "windows:.agents/skills/start-article",
        "windows:.codex/skills/start-article",
        "windows:.claude/skills/start-article",
        "wsl:.agents/skills/start-article",
        "wsl:.claude/skills/start-article"
      ],
      "invocations": {
        "codex": "$start-article",
        "claude": "/start-article",
        "gemini": "/start-article or natural-language trigger"
      },
      "account_install_targets": [
        "chatgpt:personal-skill-upload",
        "claude:custom-skill-upload-and-enable"
      ],
      "account_package": "One Agent Skills ZIP containing the start-article folder; the uploaded adapter remains current by dereferencing canonical_entrypoint.remote_url."
    }
  ]
}
