{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "outcome",
    "reverse_outline",
    "findings"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "PASS",
        "REPAIR"
      ]
    },
    "reverse_outline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section",
          "job",
          "supported_connection"
        ],
        "properties": {
          "section": {
            "type": "string"
          },
          "job": {
            "type": "string"
          },
          "supported_connection": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "artifact",
          "location",
          "finding",
          "repair_instruction"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "repair_instruction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
