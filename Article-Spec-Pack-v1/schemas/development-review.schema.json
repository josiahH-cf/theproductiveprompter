{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "outcome",
    "reverse_outline",
    "findings"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "PASS",
        "REPAIR"
      ]
    },
    "reverse_outline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section",
          "job",
          "supported_connection"
        ],
        "properties": {
          "section": {
            "type": "string"
          },
          "job": {
            "type": "string"
          },
          "supported_connection": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "artifact",
          "location",
          "finding",
          "repair_instruction"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "repair_instruction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "reader_takeaway": {
      "type": "object",
      "description": "Paraphrase of what a reader would take away from the whole draft, compared with the contract's intended understanding.",
      "required": [
        "paraphrase",
        "intended_understanding",
        "status",
        "passages"
      ],
      "properties": {
        "paraphrase": {
          "type": "string",
          "minLength": 20
        },
        "intended_understanding": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "REPAIR"
          ]
        },
        "passages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "excerpt",
              "role"
            ],
            "properties": {
              "excerpt": {
                "type": "string",
                "minLength": 8
              },
              "role": {
                "enum": [
                  "shows",
                  "explains",
                  "obscures",
                  "displaces"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "issue",
              "cause"
            ],
            "properties": {
              "issue": {
                "type": "string",
                "minLength": 1
              },
              "cause": {
                "enum": [
                  "insufficient_supplied_evidence",
                  "prose_does_not_use_evidence",
                  "displaced_center",
                  "other"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
