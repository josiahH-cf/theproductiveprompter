{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/run.schema.json",
  "title": "Article Flow Run",
  "type": "object",
  "required": [
    "run_schema_version",
    "run_id",
    "workflow_version",
    "created_at",
    "updated_at",
    "state",
    "status",
    "event_log",
    "artifact_index",
    "attempts"
  ],
  "properties": {
    "run_schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^AF-[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+-[0-9a-f]{8}$"
    },
    "workflow_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "WAITING_MODEL",
        "WAITING_HUMAN",
        "BLOCKED",
        "COMPLETE",
        "TERMINAL"
      ]
    },
    "event_log": {
      "type": "string"
    },
    "applied_event_head": {
      "type": "object",
      "required": [
        "sequence",
        "event_hash"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "artifact_index": {
      "type": "array",
      "items": {
        "$ref": "artifact.schema.json"
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "lock": {
      "type": [
        "object",
        "null"
      ]
    },
    "run_overrides": {
      "type": "object"
    },
    "publication": {
      "type": "object"
    },
    "automation_mode": {
      "enum": [
        "manual",
        "active_session"
      ]
    },
    "publication_hold": {
      "type": "boolean"
    },
    "model_assignment": {
      "oneOf": [
        {
          "$ref": "model-assignment.schema.json"
        },
        {
          "type": "string"
        }
      ]
    },
    "assigned_writing_route": {
      "type": "object"
    },
    "actual_writing_routes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "effective_voice_profile_version": {
      "type": "string"
    },
    "style_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "writing_model_fallback_status": {
      "enum": [
        "none",
        "fallback",
        "contaminated"
      ]
    }
  },
  "additionalProperties": true
}
