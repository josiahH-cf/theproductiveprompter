{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/package.schema.json",
  "title": "Article Package",
  "type": "object",
  "required": ["package_schema_version", "run_id", "workflow_version", "package_revision", "canonical_article_file", "public_files", "private_archive", "created_at"],
  "properties": {
    "package_schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "workflow_version": {"type": "string"},
    "package_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_article_file": {"const": "public/article.md"},
    "public_files": {"type": "array", "items": {"type": "object"}},
    "private_archive": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
