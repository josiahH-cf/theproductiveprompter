{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/claim-ledger.schema.json",
  "title": "Article Claim Ledger",
  "type": "object",
  "required": ["claim_ledger_schema_version", "run_id", "generated_at", "claims"],
  "properties": {
    "claim_ledger_schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "exact_claim", "class", "risk", "source_tier", "source_url_or_local_id", "source_title_and_publisher", "exact_locator_or_supporting_excerpt", "checked_at", "freshness_horizon", "contradiction_status", "allowed_wording", "confidence", "disposition"],
        "properties": {
          "claim_id": {"type": "string"},
          "exact_claim": {"type": "string"},
          "class": {"enum": ["fact", "inference", "opinion", "project_observation"]},
          "risk": {"enum": ["low", "medium", "high"]},
          "source_tier": {"type": ["string", "null"]},
          "source_url_or_local_id": {
            "type": ["string", "null"],
            "description": "Exactly one direct HTTP(S) URL or one local input locator. Never concatenate multiple sources in this field."
          },
          "source_title_and_publisher": {"type": ["string", "null"]},
          "exact_locator_or_supporting_excerpt": {"type": ["string", "null"]},
          "checked_at": {"type": ["string", "null"]},
          "freshness_horizon": {"type": ["string", "null"]},
          "contradiction_status": {"enum": ["none_found", "resolved", "unresolved", "not_applicable"]},
          "allowed_wording": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "disposition": {"enum": ["use", "qualify", "omit", "escalate"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
