{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/research-plan.schema.json",
  "title": "Article Research Plan",
  "type": "object",
  "required": ["research_plan_schema_version", "run_id", "questions", "source_strategy", "claim_risks", "no_search_behavior"],
  "properties": {
    "research_plan_schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question", "why_it_matters", "intent_changing"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "why_it_matters": {"type": "string", "minLength": 1},
          "intent_changing": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "source_strategy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "claim_risks": {"type": "array", "items": {"type": "object"}},
    "no_search_behavior": {"enum": ["approved-local-corpus", "generalize-or-omit", "escalate", "not-applicable"]}
  },
  "additionalProperties": true
}
