{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/visual-plan.schema.json",
  "title": "Article Visual Plan",
  "type": "object",
  "required": ["visual_plan_schema_version", "run_id", "visuals"],
  "properties": {
    "$schema": {"type": "string"},
    "visual_plan_schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "omission_reason": {"type": "string", "minLength": 20, "maxLength": 500},
    "visuals": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["visual_id", "kind", "title", "purpose", "placement", "alt_text", "caption", "claim_ids", "labels"],
        "properties": {
          "visual_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,48}$"},
          "kind": {"enum": ["console_reconstruction", "trend_gap", "delivery_loop", "branching_effects"]},
          "title": {"type": "string", "minLength": 3, "maxLength": 100},
          "purpose": {"type": "string", "minLength": 10, "maxLength": 300},
          "placement": {
            "type": "object",
            "oneOf": [{"required": ["after_heading"]}, {"required": ["after_paragraph"]}],
            "properties": {"after_heading": {"type": "string", "minLength": 2}, "after_paragraph": {"type": "string", "minLength": 20, "maxLength": 3000}},
            "additionalProperties": false
          },
          "alt_text": {"type": "string", "minLength": 20, "maxLength": 320},
          "caption": {"type": "string", "minLength": 10, "maxLength": 320},
          "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "labels": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 90}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
