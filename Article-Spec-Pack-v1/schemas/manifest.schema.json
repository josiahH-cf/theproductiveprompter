{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/manifest.schema.json",
  "title": "Article Flow Release Manifest",
  "type": "object",
  "required": ["manifest_schema_version", "workflow_version", "hash_algorithm", "generator_name_and_version", "generated_at", "generated_from", "files"],
  "properties": {
    "manifest_schema_version": {"const": "2.0.0"},
    "workflow_version": {"type": "string"},
    "hash_algorithm": {"const": "sha256"},
    "generator_name_and_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_from": {"enum": ["index", "commit"]},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "scope", "role", "rule_set", "sha256", "byte_size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "scope": {"enum": ["spec", "repository"]},
          "role": {"enum": ["normative", "template", "runtime", "documentation", "archived"]},
          "rule_set": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_size": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
