{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/task-packet.schema.json",
  "title": "Provider-Neutral Task Packet",
  "type": "object",
  "required": ["task_packet_schema_version", "workflow_version", "run_id", "stage", "attempt", "objective", "inputs", "reader_job", "article_recipe", "allowed_tools", "side_effect_policy", "constraints", "expected_outputs", "success_criteria", "non_authorities", "stop_conditions", "escalation_question"],
  "properties": {
    "task_packet_schema_version": {"const": "1.0.0"},
    "workflow_version": {"type": "string"},
    "run_id": {"type": "string"},
    "stage": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "objective": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "reader_job": {"type": ["string", "null"]},
    "article_recipe": {"type": ["object", "null"]},
    "allowed_tools": {"type": "array", "items": {"type": "string"}},
    "side_effect_policy": {"type": "string"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_authorities": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "escalation_question": {"type": "string"},
    "selected_route": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
