{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/workflow.schema.json",
  "title": "Article Flow Workflow",
  "type": "object",
  "required": [
    "workflow_schema_version",
    "workflow_version",
    "authority",
    "precedence",
    "gate_outcomes",
    "states",
    "gates",
    "rules"
  ],
  "properties": {
    "workflow_schema_version": {
      "type": "string"
    },
    "workflow_version": {
      "type": "string"
    },
    "authority": {
      "const": true
    },
    "precedence": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "gate_outcomes": {
      "type": "array",
      "items": {
        "enum": [
          "PASS",
          "REPAIR",
          "RETRY",
          "ESCALATE",
          "TERMINAL"
        ]
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "actor",
          "objective",
          "required_inputs",
          "output",
          "side_effect_class",
          "next_on_pass",
          "max_attempts",
          "timeout_seconds",
          "retry_policy",
          "escalation_condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "actor": {
            "type": "string"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "required_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_schema": {
            "type": [
              "string",
              "null"
            ]
          },
          "side_effect_class": {
            "enum": [
              "none",
              "local_reversible",
              "read_only_external",
              "irreversible_external"
            ]
          },
          "gate": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_on_pass": {
            "type": [
              "string",
              "null"
            ]
          },
          "repair_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "retry_policy": {
            "type": "string",
            "minLength": 1
          },
          "escalation_condition": {
            "type": "string",
            "minLength": 1
          },
          "normal_action": {
            "enum": [
              "human_decision",
              "automatic",
              "run_command"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "object",
      "required": [
        "hard",
        "soft"
      ],
      "properties": {
        "hard": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "soft": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AF-[A-Z]+-[0-9]{3}$"
          },
          "level": {
            "enum": [
              "MUST",
              "SHOULD",
              "MAY"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "automation_boundary": {
      "type": "object",
      "required": [
        "default_mode",
        "routine_human_decision_states",
        "automatic_states",
        "exceptional_stops"
      ],
      "properties": {
        "default_mode": {
          "enum": [
            "manual",
            "active_session"
          ]
        },
        "routine_human_decision_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "automatic_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "exceptional_stops": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
