{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/gate-receipt.schema.json",
  "title": "Article Flow Gate Receipt",
  "type": "object",
  "required": ["gate_receipt_schema_version", "run_id", "gate_id", "gate_class", "artifact_hashes", "outcome", "criteria", "findings", "repair_state", "evaluator", "created_at"],
  "properties": {
    "gate_receipt_schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "run_id": {"type": "string"},
    "gate_id": {"type": "string"},
    "gate_class": {"enum": ["hard", "soft"]},
    "artifact_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "outcome": {"enum": ["PASS", "REPAIR", "RETRY", "ESCALATE", "TERMINAL"]},
    "criteria": {"type": "array", "items": {"type": "object"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "artifact", "location", "finding", "repair_instruction"],
        "properties": {
          "criterion": {"type": "string"},
          "artifact": {"type": "string"},
          "location": {"type": ["string", "null"]},
          "finding": {"type": "string"},
          "repair_instruction": {"type": "string"},
          "repair_state": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "repair_state": {"type": ["string", "null"]},
    "evaluator": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "task_binding": {
      "type": "object",
      "required": ["state", "attempt", "task_packet_sha256"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "task_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"gate_receipt_schema_version": {"const": "1.0.0"}},
        "required": ["gate_receipt_schema_version"]
      },
      "then": {"not": {"required": ["task_binding"]}}
    },
    {
      "if": {
        "properties": {"gate_receipt_schema_version": {"const": "1.1.0"}},
        "required": ["gate_receipt_schema_version"]
      },
      "then": {"required": ["task_binding"]}
    }
  ],
  "additionalProperties": false
}
