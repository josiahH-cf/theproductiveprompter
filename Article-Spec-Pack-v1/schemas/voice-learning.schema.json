{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/voice-learning.schema.json",
  "title": "Voice Learning Record",
  "type": "object",
  "required": [
    "voice_learning_schema_version",
    "record_id",
    "run_id",
    "idempotency_key",
    "created_at",
    "voice_probe_sha256",
    "rough_draft_sha256",
    "claim_ledger_sha256",
    "prior_profile_version",
    "new_profile_version",
    "selected_candidate",
    "rejected_candidates",
    "controlled_dimensions",
    "operator_feedback",
    "writing_model",
    "profile_update"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "voice_learning_schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "voice_probe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rough_draft_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_ledger_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prior_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "new_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "selected_candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "passage",
        "passage_sha256"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "passage": {
          "type": "string",
          "minLength": 1
        },
        "passage_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "intended_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "preserved_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "rejected_candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "passage",
          "passage_sha256"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "passage": {
            "type": "string",
            "minLength": 1
          },
          "passage_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "intended_dimensions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "preserved_claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "controlled_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operator_feedback": {
      "type": [
        "string",
        "null"
      ]
    },
    "writing_model": {
      "type": "object",
      "required": [
        "provider_id",
        "model_id",
        "public_display_name"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "public_display_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "profile_update": {
      "type": "object",
      "required": [
        "status",
        "activated",
        "guidance_added",
        "guidance_refined",
        "runtime_guidance_retired",
        "positive_example_ids",
        "pair_ids"
      ],
      "properties": {
        "status": {
          "const": "provisional"
        },
        "activated": {
          "type": "boolean"
        },
        "guidance_added": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "guidance_refined": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "runtime_guidance_retired": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "positive_example_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "pair_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
