{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/voice-profile-pointer.schema.json",
  "title": "Current Runtime Voice Profile Pointer",
  "type": "object",
  "required": [
    "voice_profile_pointer_schema_version",
    "profile_id",
    "current_version",
    "profile_sha256",
    "updated_at",
    "source_learning_record_id"
  ],
  "properties": {
    "voice_profile_pointer_schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "current_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_learning_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
