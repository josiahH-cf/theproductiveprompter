{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theproductiveprompter.com/schemas/revision.schema.json",
  "title": "Same-URL Article Revision",
  "type": "object",
  "required": [
    "revision_schema_version",
    "source_run_id",
    "mode",
    "slug",
    "canonical_url",
    "original_published_date",
    "requested_at",
    "request_sha256"
  ],
  "properties": {
    "revision_schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "source_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "const": "replace_in_place"
    },
    "slug": {
      "type": "string"
    },
    "canonical_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "original_published_date": {
      "type": "string"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_kind": {
      "enum": [
        "completed_run",
        "verified_published_snapshot"
      ]
    },
    "original_published_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source_html_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "source_observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "revision_schema_version": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "required": [
          "source_kind",
          "original_published_timestamp",
          "source_html_sha256",
          "source_commit",
          "source_observed_at"
        ]
      }
    }
  ]
}
